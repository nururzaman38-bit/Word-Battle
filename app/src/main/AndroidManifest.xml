<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".WordBattleApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WordBattle"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.WordBattle.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

        <activity
            android:name=".ui.activities.GameBoardActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".ui.activities.RoomSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

        <activity
            android:name=".ui.activities.JoinRoomActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

        <activity
            android:name=".ui.activities.LobbyActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

        <activity
            android:name=".ui.activities.ResultsActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

        <activity
            android:name=".ui.activities.AssignmentActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

        <activity
            android:name=".ui.activities.SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

        <activity
            android:name=".ui.activities.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

        <activity
            android:name=".ui.activities.FriendsActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

        <activity
            android:name=".ui.activities.RankActivity"
            android:exported="false"
            android:theme="@style/Theme.WordBattle" />

    </application>

</manifest>
